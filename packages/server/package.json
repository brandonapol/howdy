{
  "name": "@howdy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
