    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.267",
    "@hono/node-server": "^2.1.1",
    "@howdy/core": "*",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2"
  }
}
